# Copia este archivo a .env y completa los valores del proveedor que vayas a usar.
# No compartas .env: puede contener claves privadas y ya esta excluido de Git.

# Datos de la API y origenes del frontend
DATA_DIR=data/06_web
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Endpoint de chat compatible con la API de OpenAI.
# Configura la URL y el nombre del modelo de tu proveedor; la URL debe terminar en /v1.
# Deja la clave vacia si usas un servidor local que no la requiere.
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
MODEL_LLM=gemma4:31b
# 1 desactiva el modo thinking en proveedores compatibles con vLLM/SGLang; otros pueden ignorarlo.
LLM_DISABLE_THINKING=1

# Busqueda web opcional: elige "tavily" o "brave" y configura solo la clave correspondiente.
# Deja WEB_PROVIDER vacio para desactivar las busquedas en vivo.
WEB_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
WEB_DOMAINS=nasa.gov,esa.int,usgs.gov,jaxa.jp,lpi.usra.edu,arxiv.org,doi.org
WEB_CACHE=data/rag/web_cache.json
WEB_TTL_HOURS=168
WEB_CACHE_ONLY=0

# Archivos de datos RAG y seleccion de modelos
RAG_CORPUS=data/rag/corpus.jsonl
RAG_EXPLANATIONS=data/rag/explanations.json
# bm25 es ligero; hybrid requiere sentence-transformers y descarga modelos.
RETRIEVER=bm25
MODEL_EMBEDDINGS=BAAI/bge-m3
MODEL_RERANKER=BAAI/bge-reranker-v2-m3

# Limites de solicitudes y comportamiento tras un proxy inverso
WEB_RATE_LIMIT_PER_MIN=10
CHAT_RATE_LIMIT_PER_MIN=10
TRUST_PROXY=0

# Solo lo usa scripts/write_with_llm.py --backend local.
USE_4BIT=1
